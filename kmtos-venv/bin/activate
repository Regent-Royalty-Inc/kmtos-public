# Minimal safe activate for kmtos-venv (no PS1 changes, no prints)
VIRTUAL_ENV="$HOME/kmtos-public/kmtos-venv"
VIRTUAL_ENV_DISABLE_PROMPT=1
export VIRTUAL_ENV VIRTUAL_ENV_DISABLE_PROMPT
export PATH="$VIRTUAL_ENV/bin:$PATH"

deactivate() {
  PATH=$(echo "$PATH" | sed -e "s|$VIRTUAL_ENV/bin:||")
  export PATH
  unset VIRTUAL_ENV
  unset VIRTUAL_ENV_DISABLE_PROMPT
  return 0
}
